=/  m  (strand ,vase)
;<  our=@p  bind:m  get-our
=/  wire  /rover-event-report
;<  ~  bind:m  (watch wire [our %obelisk] /server)
;<  ~  bind:m  (poke [our %obelisk] %obelisk-action !>([%script %rover %vector "FROM vehicles V JOIN vehicle-events E ON V.vehicle-id = E.vehicle-id SELECT V.label AS vehicle, E.observed-start, E.observed-precision, E.source-zone; FROM service-events S SELECT S.event-id AS service; FROM expense-events X SELECT X.event-id AS expense; FROM note-events Z SELECT Z.event-id AS note; FROM vehicle-acquisitions A SELECT A.event-id AS acquisition; FROM vehicle-disposals D JOIN disposal-kind-definitions K ON D.disposal-kind-id = K.disposal-kind-id SELECT D.event-id AS disposal, K.label AS disposal-kind; FROM vehicle-event-costs C JOIN vehicle-event-cost-totals T ON C.event-id = T.event-id SELECT C.cost-state, C.currency, C.minor-unit-decimals, T.total-mills; FROM odometer-observations O JOIN vehicle-event-odometers L ON O.odometer-id = L.odometer-id SELECT L.event-id, O.value-digits, O.decimal-places, O.unit; FROM places P JOIN stations S ON P.place-id = S.place-id JOIN vehicle-event-stations L ON S.station-id = L.station-id SELECT L.event-id, S.label AS station, P.label AS place; FROM tag-definitions T JOIN vehicle-event-tags L ON T.tag-id = L.tag-id SELECT L.event-id, T.label AS tag; FROM payment-method-definitions P JOIN vehicle-event-payment-method L ON P.method-id = L.method-id SELECT L.event-id, P.label AS payment-method; FROM vehicle-event-notes X SELECT X.event-id, X.note;"]))
;<  [mark =vase]  bind:m  (take-fact wire)
;<  ~  bind:m  (take-kick wire)
(pure:m vase)
