/+  render=rover-render
::
?>  =('12.345' (format-scaled:render 12.345 3 %.n))
?>  =('0.005' (format-scaled:render 5 3 %.n))
?>  =('12,345' (format-scaled:render 12.345 0 %.y))
?>  =('10,012.5' (format-scaled:render 100.125 1 %.y))
::
?>  =('12.345 gal' (format-quantity:render 12.345 %gal))
?>  =('$3.499' (format-unit-price:render 3.499 %usd))
?>  =('$43.19' (format-total:render 43.190 %usd 2))
?>  =('10,012.5 mi' (format-distance:render 100.125 1 %mi %.n))
=/  converted  (format-distance:render 161.135 1 %km %.y)
?>  =('16,113.5 km (converted)' converted)
=/  to-km  (convert-distance:render 100.125 1 %mi %km)
?>  =([161.136 1 %km %.y] to-km)
?>  =('16,113.6 km (converted)' (format-distance:render converted-digits.to-km converted-places.to-km converted-unit.to-km converted.to-km))
=/  untouched  (convert-distance:render 200.000 1 %mi %mi)
?>  =([200.000 1 %mi %.n] untouched)
=/  north  (format-coordinate:render (new:si %.y 377.749.295) 7)
?>  =('37.7749295' north)
=/  west  (format-coordinate:render (new:si %.n 876.297.982) 7)
?>  =('-87.6297982' west)
=/  observed  (format-da:render ~2026.7.28..12.00.00)
?>  =('2026-07-28 12:00:00' observed)
::
=/  qty  (parse-decimal:render '12.345' 3)
?>  ?=(%& -.qty)
?>  =([12.345 3] p.qty)
=/  odo  (parse-decimal:render '10,012.5' 3)
?>  ?=(%& -.odo)
?>  =([100.125 1] p.odo)
=/  bad  (parse-decimal:render '12.3456' 3)
?>  ?=(%| -.bad)
?>  =(%excess-precision p.bad)
=/  us-short  (parse-us-price:render '$3.49')
?>  ?=(%& -.us-short)
?>  =([3.499 '$3.499'] p.us-short)
=/  us-exact  (parse-us-price:render '$3.499')
?>  ?=(%& -.us-exact)
?>  =([3.499 '$3.499'] p.us-exact)
=/  bad-price  (parse-us-price:render '$3.x9')
?>  ?=(%| -.bad-price)
?>  =(%bad-shape p.bad-price)
%render-tests-pass
